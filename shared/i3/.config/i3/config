# s
bindsym $mod+s        			    sticky toggle;
bindsym $mod+Shift+s			      move scratchpad

# d
bindsym $mod+d                  exec --no-startup-id i3-dmenu-desktop --dmenu='dmenu -b -i'

# f
bindsym $mod+f			            fullscreen toggle
bindsym $mod+Shift+f 	          floating toggle

