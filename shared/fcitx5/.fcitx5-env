#!/usr/bin/env bash
# Shared fcitx5 IME configuration for both X11 and Wayland sessions
# This sets up the environment variables needed for proper Chinese input

# fcitx5 IME Modules
export GTK_IM_MODULE=fcitx5
export QT_IM_MODULE=fcitx5
export GLFW_IM_MODULE=ibus

# DBus Session (required for fcitx5 to communicate with session)
export XDG_RUNTIME_DIR=/run/user/"$UID"
export DBUS_SESSION_BUS_ADDRESS=unix:path="$XDG_RUNTIME_DIR"/bus

# Optional: Uncomment if you need XMODIFIERS for some X11 apps
# export XMODIFIERS=@im=fcitx5