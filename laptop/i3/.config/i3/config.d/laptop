# vim: filetype=i3config
# Laptop-specific i3 configuration
# This is included by the shared i3 config

# #---Status bar---# #
exec --no-startup-id $HOME/.config/polybar/launch.sh

# #---Autostart---# #
# default display config
exec --no-startup-id $scripts_dir/dual_display.sh
exec_always --no-startup-id feh --bg-scale /usr/share/wallpapers/MilkyWay/contents/images/5120x2880.png
exec --no-startup-id picom -b
exec --no-startup-id /usr/bin/lxpolkit
exec --no-startup-id dunst
exec --no-startup-id parcellite

# chinese ime
exec --no-startup-id fcitx5 -d
exec --no-startup-id nm-applet
exec_always --no-startup-id autotiling

exec --no-startup-id XDG_MENU_PREFIX=plasma- kbuildsyscoca6

# Synaptics touchpad (laptop-specific)
exec --no-startup-id synclient RightButtonAreaLeft=0
exec --no-startup-id synclient RightButtonAreaTop=0
exec --no-startup-id synclient HorizTwoFingerScroll=1
exec --no-startup-id synclient AreaRightEdge=1175
exec --no-startup-id synclient AreaLeftEdge=222

# xinput
exec --no-startup-id $scripts_dir/xinput-config.sh

# #---Laptop Navigation (use $mod+hjkl)---# #
bindsym $mod+h			            focus left
bindsym $mod+Shift+h		        move left 30
bindsym $mod+Ctrl+h		          move workspace to output left

bindsym $mod+j			            focus down
bindsym $mod+Shift+j		        move down 30
bindsym $mod+Ctrl+j		          move workspace to output down

bindsym $mod+k			            focus up
bindsym $mod+Shift+k		        move up 30
bindsym $mod+Ctrl+k		          move workspace to output up

bindsym $mod+l			            focus right
bindsym $mod+Shift+l		        move right 30
bindsym $mod+Ctrl+l		          move workspace to output right

# #---Focus mode toggle---# #
bindsym $mod+a            focus mode_toggle

# #---Function Buttons (laptop display management)---# #
bindsym $mod+F3		        exec --no-startup-id screenkey
bindsym $mod+F4			exec --no-startup-id killall screenkey
bindsym $mod+F5			exec --no-startup-id $scripts_dir/single_display.sh
bindsym $mod+F6			exec --no-startup-id $scripts_dir/dual_display.sh
bindsym $mod+F7			exec --no-startup-id $scripts_dir/dual_display_LG.sh

# Allow suspend binding
bindsym $mod+Shift+c		        exec --no-startup-id $suspend
